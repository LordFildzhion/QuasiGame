;==========================================================================================
; INF-file for installing the standard Windows driver (WinUSB) for Neurosoft USB devices.
; Processor support for OS x86 & amd64.
; Copyright (c) Neurosoft Ltd. 2022
;==========================================================================================

[Version]
Signature   = "$Windows NT$"
Class		= NeuroSoftUSBdevices
ClassGUID   = {E488380F-E249-4b22-9848-D203EE085313}
Provider    = %ManufacturerName%
CatalogFile = NS_WinUSB.cat
DriverVer   = 01/31/2023, 2.0.0.9 ; MM/DD/YYYY, version
PnpLockdown = 1

[ClassInstall32] 
AddReg = ClassInstall_AddReg

[ClassInstall_AddReg]
HKR,,,,"%NeurosoftDeviceClassDisplayName%"
HKR,,Icon,,"-20"

; ========== Manufacturer/Models sections ===========

[Manufacturer]
%ManufacturerName% = Standard,NTx86,NTamd64

[Standard.NTx86]
%DeviceDesc_0547_2235% = Install_xxxx_xxxx, USB\VID_0547&PID_2235
