; =================== Installation ===================
[Install_xxxx_xxxx]
Include = winusb.inf
Needs = WINUSB.NT

[Install_xxxx_xxxx.Services]
Include = winusb.inf
Needs = WINUSB.NT.Services

[Install_xxxx_xxxx.HW]
AddReg = Dev_AddReg_xxxx_xxxx

[Install_xxxx_xxxx.Wdf]
KmdfService = WINUSB, WinUsb_Install

[Dev_AddReg_xxxx_xxxx]
HKR,,DeviceInterfaceGUIDs,0x10008,"{52F5619D-D8A4-42C4-B2F9-D19171C660A4}"


[Install_ACCA_820X]
Include = winusb.inf
Needs = WINUSB.NT

[Install_ACCA_820X.Services]
Include = winusb.inf
Needs = WINUSB.NT.Services

[Install_ACCA_820X.HW]
AddReg = Dev_AddReg_ACCA_820X, Dev_AddReg_xxxx_xxxx

[Install_ACCA_820X.Wdf]
