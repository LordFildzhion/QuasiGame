[Mcs.Dev.NT]
CopyFiles = Mcs.Dev.Files.Drv

[Mcs.Dev.NT.Services]
AddService = %Mcs.Dev.Service%, 0x00000002, Mcs.Dev.NT.AddService

[Mcs.Dev.NT.AddService]
ServiceType    = 1 ; SERVICE_KERNEL_DRIVER
StartType      = 3 ; SERVICE_DEMAND_START
ErrorControl   = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %10%\System32\Drivers\%Mcs.Dev.Drv%

[Mcs.Dev.Files.Drv]
%Mcs.Dev.Drv%

[DestinationDirs]
Mcs.Class.Files = 10,System32
Mcs.Dev.Files.Drv = 10,System32\Drivers

[SourceDisksNames]
1=,,,\i386

[SourceDisksNames.amd64]
1=,,,\amd64

[SourceDisksFiles]
McsUsb30.sys = 1,,

;--------------------------------------------------------------------;

[DestinationDirs]
Mcs.Dev.CoInstaller.CopyFiles = 11

[Mcs.Dev.NT.CoInstallers]
AddReg = Mcs.Dev.CoInstaller.AddReg
CopyFiles = Mcs.Dev.CoInstaller.CopyFiles

[Mcs.Dev.CoInstaller.CopyFiles]
WdfCoInstaller01009.dll

[SourceDisksFiles]
WdfCoInstaller01009.dll = 1

[Mcs.Dev.CoInstaller.AddReg]
HKR,,CoInstallers32,0x00010000,"WdfCoInstaller01009.dll,WdfCoInstaller"

[Mcs.Dev.NT.Wdf]
KmdfService = %Mcs.Dev.Service%, Mcs.Dev.Wdf.Sect

[Mcs.Dev.Wdf.Sect]
KmdfLibraryVersion = 1.9

;--------------------------------------------------------------------;

[Strings]
