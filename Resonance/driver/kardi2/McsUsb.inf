[Version]
Signature="$WINDOWS NT$"
Class = McsClass
ClassGuid = {528D322C-0809-11D4-89C1-0060520407E9}
Provider=%Mcs.Name%
CatalogFile = McsUsb.cat
DriverVer=10/10/2013,3.0.0.0
DriverPackageDisplayName=%Mcs.Package.Desc%

;--------------------------------------------------------------------;

[ClassInstall32]
Addreg=McsClassAddReg
CopyFiles = Mcs.Class.Files

[ClassInstall]
Addreg=McsClassAddReg
CopyFiles = Mcs.Class.Files

[McsClassAddReg]
HKR,,,,%Mcs.ClassName%
;
HKR,,Icon,,-20

[Mcs.Class.Files]
;

;--------------------------------------------------------------------;

[Manufacturer]
;
%Mcs.Name% = MCS, NTamd64

;--------------------------------------------------------------------;

[MCS]

; KARDi2N series
%Mcs.Dev.DeviceDesc2000%=Mcs.Dev, USB\VID_0B6E&PID_2000
