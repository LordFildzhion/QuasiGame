[SourceDisksNames]
1=%SrcDiskName%,,

[SourceDisksFiles]
NewEzUsb_X86.sys = 1,,
NewEzUsb_AMD64.sys = 1,,

[DestinationDirs]
NewEzUsb.Files = 10,System32\Drivers
NewEzUsb.Files.X64 = 10,System32\Drivers

[NewEzUsb.Files]
NewEzUsb_X86.sys

[NewEzUsb.Files.X64]
NewEzUsb_AMD64.sys

[ControlFlags]
ExcludeFromSelect = *

[NewEzUsb.NTx86]
CopyFiles=NewEzUsb.Files
AddReg=NewEzUsb.AddReg.NTx86

[NewEzUsb.NTx86.HW]
AddReg=NewEzUsb.AddReg.Guid

[NewEzUsb.NTx86.Services]
Addservice = NewEzUsbx86,2,NewEzUsbx86.AddService

[NewEzUsb.NTamd64]
CopyFiles=NewEzUsb.Files.X64
AddReg=NewEzUsb.AddReg.NTamd64

[NewEzUsb.NTamd64.HW]
AddReg=NewEzUsb.AddReg.Guid

[NewEzUsb.NTamd64.Services]
Addservice = NewEzUsbx64,2,NewEzUsbx64.AddService

[NewEzUsbx86.AddService]
DisplayName    = %NewEzUsb_Description%
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 3                  ; SERVICE_DEMAND_START
ErrorControl   = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %10%\System32\Drivers\NewEzUsb_X86.sys
AddReg         = NewEzUsb.AddReg.NTx86
LoadOrderGroup = Base

[NewEzUsbx64.AddService]
DisplayName    = %NewEzUsb_Description%
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 3                  ; SERVICE_DEMAND_START
ErrorControl   = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %10%\System32\Drivers\NewEzUsb_AMD64.sys
AddReg         = NewEzUsb.AddReg.NTamd64
LoadOrderGroup = Base

[NewEzUsb.AddReg.NTx86]
; Deprecating - do not use in new apps to identify a driver
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,NewEzUsb_X86.sys
; You may optionally include a check for DriverBase
HKR,,DriverBase,,NewEzUsb_X86.sys
HKR,"Parameters","MaximumTransferSize",0x10001,4096
HKR,"Parameters","DebugLevel",0x10001,2
HKR,,FriendlyName,,%NewEzUsb_Description%

[NewEzUsb.AddReg.NTamd64]
; Deprecating - do not use in new apps to identify a driver
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,NewEzUsb_AMD64.sys
; You may optionally include a check for DriverBase
HKR,,DriverBase,,NewEzUsb_AMD64.sys
HKR,"Parameters","MaximumTransferSize",0x10001,4096
HKR,"Parameters","DebugLevel",0x10001,2
HKR,,FriendlyName,,%NewEzUsb_Description%

[NewEzUsb.AddReg.Guid]
HKR,,DriverGUID,,%NewEzUsb_CUID%

